        {
            "label": "build-lsp-dev",
            "type": "shell",
            "command": "node scripts/copy-lsp.js",
            "group": "build",
            "presentation": { "reveal": "silent" },
            "problemMatcher": []
        },
        {
            "label": "watch",
            "type": "shell",
            "command": "npm run watch",
            "group": "build",
            "isBackground": true,
            "presentation": { "reveal": "silent" },
            "problemMatcher": "$tsc-watch"
        }
    ]
}
