{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "npm run compile",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn": ["build-lsp-dev"],
            "presentation": { "reveal": "silent" },
            "problemMatcher": ["$tsc"]
